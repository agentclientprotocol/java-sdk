<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentclientprotocol</groupId>
        <artifactId>acp-java-sdk</artifactId>
        <version>0.19.0-SNAPSHOT</version>
    </parent>

    <artifactId>acp-annotations</artifactId>
    <name>ACP Annotations</name>
    <description>Zero-dependency annotations for ACP agent development</description>

    <!--
    IMPORTANT: This module has ZERO transitive dependencies by design.
    It contains only annotation definitions that can be used
    without pulling in the full ACP runtime.
    -->

    <properties>
        <!-- Coverage floors: annotation types only, no executable code. JaCoCo counts no
             lines or branches here and an empty ratio passes, so the floors stay at the
             parent's full coverage: code added to this module must be covered or measured. -->
        <jacoco.minimum.line>1.00</jacoco.minimum.line>
        <jacoco.minimum.branch>1.00</jacoco.minimum.branch>
    </properties>

    <dependencies>
        <!-- The only compile dependency, and optional so consumers inherit nothing: JSpecify's
             annotations null-mark this module's package for the build's NullAway check.
             They have no runtime role. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test only: the module's architecture rules. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
