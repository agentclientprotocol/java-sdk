{
  "name": "x-java-rust-http",
  "description": "java client -> rust agent over http, stable profile, 70 steps (generated)",
  "timeoutSec": 590,
  "peers": [
    "rust-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "rust",
      "role": "server",
      "dir": "${ROOT}/programs/rust",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" RUST_SDK=\"${peer.rust-sdk}\" CARGO_TARGET_DIR=\"${CACHE}/build/${peerKey.rust-sdk}\" ${ROOT}/programs/rust/launch/build.sh",
      "run": "${ROOT}/programs/rust/launch/agent.sh --transport http --port ${PORT}",
      "env": {
        "RUST_SDK": "${peer.rust-sdk}",
        "CARGO_TARGET_DIR": "${CACHE}/build/${peerKey.rust-sdk}"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/java/launch/build.sh",
      "run": "${ROOT}/programs/java/launch/client.sh --transport http --url http://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.client-capabilities,init.auth-methods,init.agent-info,init.config-boolean,auth.authenticate,auth.logout,auth.logout-capability,auth.terminal,session.new,session.load,session.load-replay,session.resume,session.list,session.close,session.delete,session.multi,update.agent_message_chunk,update.user_message_chunk,update.agent_thought_chunk,update.tool_call,update.tool_call_update,update.tool_call-name,update.plan,update.available_commands_update,update.current_mode_update,update.config_option_update,update.session_info_update,update.usage_update,update.unknown,stop.max_tokens,stop.refusal,stop.max_turn_requests,enum.tool_call,enum.plan,enum.stop,enum.audience,mode.set,config.on-new,config.select,config.boolean,config.grouped,perm.selected,perm.cancelled,fs.write,fs.read,fs.read-range,fs.read-missing,term.run,term.kill,elicit.form,elicit.complete,cancel.prompt,cancel-request.client,cancel-request.agent,cancel-request.unknown,ext.agent-request,ext.agent-notification,ext.client-request,ext.client-notification,meta.prompt,meta.permission,error.method-not-found,big.prompt-1m,big.update-1m,big.prompt-8m,big.update-8m,http.reconnect,conn.close",
        "RUST_SDK": "${peer.rust-sdk}",
        "CARGO_TARGET_DIR": "${CACHE}/build/${peerKey.rust-sdk}"
      },
      "timeoutSec": 470
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.init.client-capabilities PASS",
        "STEP agent.auth.authenticate PASS",
        "STEP agent.session.close PASS",
        "STEP agent.mode.set PASS",
        "STEP agent.config.grouped PASS",
        "STEP agent.perm.selected PASS",
        "STEP agent.perm.cancelled PASS",
        "STEP agent.fs.write PASS",
        "STEP agent.fs.read PASS",
        "STEP agent.fs.read-range PASS",
        "STEP agent.fs.read-missing PASS",
        "STEP agent.term.run PASS",
        "STEP agent.term.kill PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS",
        "STEP agent.cancel-request.client PASS",
        "STEP agent.cancel-request.agent PASS",
        "STEP agent.ext.agent-request PASS",
        "STEP agent.meta.permission PASS"
      ],
      "client": [
        "negotiated HTTP_1_1"
      ]
    },
    "forbiddenOutput": {
      "client": [
        "negotiated HTTP_2"
      ]
    },
    "requiredPatterns": {
      "agent": [
        "\\[http\\] POST /acp HTTP/1\\.1 .*-> 200",
        "\\[http\\] DELETE /acp HTTP/1\\.1 .*-> 202"
      ]
    },
    "checks": [
      "client RESULT pass == 68",
      "client RESULT fail == 2"
    ],
    "expectedFailures": [
      {
        "process": "client",
        "step": "enum.stop",
        "contains": "-32700",
        "reason": "The Rust agent cannot answer an unknown stopReason: a typed prompt Responder re-parses even an erase_to_json() answer into PromptResponse (closed StopReason, schema src/v1/agent.rs:3182), so the SDK answers -32700 instead",
        "see": "peer:rust-sdk src/agent-client-protocol/src/jsonrpc.rs:4777 [expectations/rust.json]"
      },
      {
        "process": "client",
        "step": "enum.audience",
        "contains": "audience: user",
        "reason": "Annotations.audience is read with VecSkipError over the closed Role enum, so the agent silently drops interop_future_role and echoes \"audience: user\"",
        "see": "peer:rust-sdk agent-client-protocol-schema 1.9.1 (pinned =1.9.1 in rust-sdk Cargo.toml:38) src/v1/content.rs:568 [expectations/rust.json]"
      },
      {
        "process": "agent",
        "step": "agent.enum.audience",
        "contains": "[\"user\"]",
        "reason": "Annotations.audience is read with VecSkipError over the closed Role enum: the unknown Role is silently dropped, so the agent reads [\"user\"]",
        "see": "peer:rust-sdk agent-client-protocol-schema 1.9.1 (pinned =1.9.1 in rust-sdk Cargo.toml:38) src/v1/content.rs:568 [expectations/rust.json]"
      }
    ],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from steps.json, matrix.json and expectations/*.json; do not edit, regenerate."
}
