{
  "name": "micronaut-typescript-http",
  "description": "typescript client -> micronaut-hosted java agent over http, 6 steps",
  "timeoutSec": 300,
  "peers": [
    "typescript-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/micronaut",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/micronaut/launch/build.sh",
      "run": "${ROOT}/programs/micronaut/launch/agent.sh --transport http --port ${PORT}",
      "env": {},
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "typescript",
      "role": "client",
      "dir": "${ROOT}/programs/node",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" TS_SDK=\"${peer.typescript-sdk}\" ${ROOT}/programs/node/launch/build.sh",
      "run": "${ROOT}/programs/node/launch/client.sh --transport http --url http://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,session.new,update.agent_message_chunk,session.multi,error.method-not-found,conn.close",
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "timeoutSec": 240
    }
  ],
  "assertions": {
    "forbiddenOutput": {
      "agent": [
        " ERROR ",
        " WARN "
      ]
    },
    "checks": [
      "client RESULT pass == 6",
      "client RESULT fail == 0"
    ],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    },
    "requiredPatterns": {
      "client": [
        "STEP init\\.initialize PASS .*agentInfo=\\{\"name\":\"micronaut-echo-agent\",\"version\":\"1\\.0\\.0\""
      ]
    }
  },
  "comment": "Hand-written, not generated: the acp-micronaut sample agent (an annotated @AcpAgent bean served by acp-micronaut, programs/micronaut) against the TypeScript client, over the catalogue steps a plain echo agent answers. stdio.eof-exit checks that the Micronaut application exits when its input ends. The initialize step requires the agentInfo the agent's @AcpAgent annotation declares."
}
