{
  "name": "x-python-java-http",
  "description": "python client -> java agent over http, stable profile, 67 steps (generated)",
  "timeoutSec": 575,
  "peers": [
    "python-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/java",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/java/launch/build.sh",
      "run": "${ROOT}/programs/java/launch/agent.sh --transport http --port ${PORT}",
      "env": {
        "PY_SDK": "${peer.python-sdk}",
        "PYTHONUNBUFFERED": "1"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "python",
      "role": "client",
      "dir": "${ROOT}/programs/python",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" PY_SDK=\"${peer.python-sdk}\" PYTHONUNBUFFERED=\"1\" ${ROOT}/programs/python/launch/build.sh",
      "run": "${ROOT}/programs/python/launch/client.sh --transport http --url http://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.client-capabilities,init.auth-methods,init.agent-info,init.config-boolean,auth.authenticate,auth.logout,auth.logout-capability,auth.terminal,session.new,session.load,session.load-replay,session.resume,session.list,session.close,session.delete,session.multi,update.agent_message_chunk,update.user_message_chunk,update.agent_thought_chunk,update.tool_call,update.tool_call_update,update.tool_call-name,update.plan,update.available_commands_update,update.current_mode_update,update.config_option_update,update.session_info_update,update.usage_update,update.unknown,stop.max_tokens,stop.refusal,stop.max_turn_requests,mode.set,config.on-new,config.select,config.boolean,perm.selected,perm.cancelled,fs.write,fs.read,fs.read-range,fs.read-missing,term.run,term.kill,elicit.form,elicit.complete,cancel.prompt,cancel.prompt-while-cancelling,cancel.grace,cancel-request.client,cancel-request.agent,cancel-request.unknown,ext.agent-request,ext.agent-notification,ext.client-request,ext.client-notification,meta.prompt,meta.permission,error.method-not-found,big.prompt-1m,big.update-1m,big.prompt-8m,big.update-8m,http.reconnect,conn.close",
        "PY_SDK": "${peer.python-sdk}",
        "PYTHONUNBUFFERED": "1"
      },
      "timeoutSec": 455
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.init.client-capabilities PASS",
        "STEP agent.auth.authenticate PASS",
        "STEP agent.session.close PASS",
        "STEP agent.mode.set PASS",
        "STEP agent.perm.selected PASS",
        "STEP agent.perm.cancelled PASS",
        "STEP agent.fs.write PASS",
        "STEP agent.fs.read PASS",
        "STEP agent.fs.read-range PASS",
        "STEP agent.fs.read-missing PASS",
        "STEP agent.term.run PASS",
        "STEP agent.term.kill PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS",
        "STEP agent.meta.permission PASS"
      ]
    },
    "requiredPatterns": {
      "agent": [
        "\\[http\\] DELETE /acp HTTP/\\S+ .*-> 202"
      ]
    },
    "checks": [
      "client RESULT pass == 59",
      "client RESULT fail == 8"
    ],
    "expectedFailures": [
      {
        "process": "client",
        "step": "session.delete",
        "contains": "400",
        "reason": "The RFD never lists the session-scoped methods: the Python client sends session/delete without Acp-Session-Id (its list, http/protocol.py:52-58, has no delete) and the Java server requires the header on any request whose params name a session (StreamableHttpRouting defaultRoute), answering 400",
        "see": "spec:rfds/streamable-http-websocket-transport.mdx:124 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.client",
        "contains": "no $/cancel_request API",
        "reason": "The Python SDK has only the $/cancel_request method-name constant: no API to send it",
        "see": "peer:python-sdk meta.py:49 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.agent",
        "contains": "",
        "reason": "The Java agent cannot send $/cancel_request; it answers #fs read-slow with the chunk \"cancel-request unsupported (P2)\"",
        "see": "P2 [expectations/java.json]"
      },
      {
        "process": "agent",
        "step": "agent.cancel-request.agent",
        "contains": "P2:",
        "reason": "The Java agent cannot send $/cancel_request",
        "see": "P2 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.unknown",
        "contains": "no $/cancel_request API",
        "reason": "The Python SDK has only the $/cancel_request method-name constant: no API to send it",
        "see": "peer:python-sdk meta.py:49 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "ext.agent-request",
        "contains": "",
        "reason": "The Java agent has no generic request send; it answers #ext request with the chunk \"ext: unsupported (P9)\"",
        "see": "P9 [expectations/java.json]"
      },
      {
        "process": "agent",
        "step": "agent.ext.agent-request",
        "contains": "P9:",
        "reason": "The Java agent has no generic request send",
        "see": "P9 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "ext.agent-notification",
        "contains": "",
        "reason": "The Java agent has no generic notification send",
        "see": "P9 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "ext.client-request",
        "contains": "",
        "reason": "The Java agent cannot register an extension request handler; it answers -32601",
        "see": "P9 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "ext.client-notification",
        "contains": "",
        "reason": "The Java agent cannot register an extension notification handler, so #ext last-notification answers \"ext last: none\"",
        "see": "P9 [expectations/java.json]"
      }
    ],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from steps.json, matrix.json and expectations/*.json; do not edit, regenerate."
}
