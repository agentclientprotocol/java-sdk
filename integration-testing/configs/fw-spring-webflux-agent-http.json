{
  "name": "fw-spring-webflux-agent-http",
  "description": "typescript client -> spring-webflux-hosted java agent over http, 14 smoke steps (generated from smoke.json)",
  "timeoutSec": 370,
  "peers": [
    "typescript-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/spring",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/spring/launch/build.sh",
      "run": "${ROOT}/programs/spring/launch/agent.sh --web reactive --transport http --port ${PORT}",
      "env": {
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 90
      }
    },
    {
      "name": "client",
      "language": "typescript",
      "role": "client",
      "dir": "${ROOT}/programs/node",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" TS_SDK=\"${peer.typescript-sdk}\" ${ROOT}/programs/node/launch/build.sh",
      "run": "${ROOT}/programs/node/launch/client.sh --transport http --url http://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.agent-info,session.new,session.load,session.multi,update.agent_message_chunk,perm.selected,elicit.form,cancel.prompt,ext.client-request,error.method-not-found,http.reconnect,conn.close",
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "timeoutSec": 190
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.perm.selected PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS"
      ]
    },
    "forbiddenOutput": {
      "agent": [
        " ERROR ",
        " WARN "
      ]
    },
    "requiredPatterns": {
      "client": [
        "STEP init\\.initialize PASS .*\"name\":\"interop-spring-agent\""
      ]
    },
    "checks": [
      "client RESULT pass == 14",
      "client RESULT fail == 0"
    ],
    "expectedFailures": [],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from smoke.json, steps.json and matrix.json; do not edit, regenerate."
}
