{
  "name": "load-50",
  "description": "50 connections x 10 prompts, two streamed updates each",
  "timeoutSec": 420,
  "comment": "Baselines from the 2026-09-25 pre-release load run. Latency (p50/p99) is recorded, never asserted.",
  "processes": [
    {
      "name": "server",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/java",
      "build": "${MVNW} -q -B -Dacp.version=${ACP_VERSION} compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt",
      "run": "java -Xmx512m -cp target/classes:$(cat target/classpath.txt) load.LoadServer ${PORT} 50",
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      },
      "samples": [
        {
          "label": "idle",
          "on": "ready"
        },
        {
          "label": "peak",
          "on": "line",
          "process": "clients",
          "line": "PEAK_REACHED"
        },
        {
          "label": "after_close",
          "on": "exit",
          "process": "clients",
          "delayMs": 3000
        }
      ]
    },
    {
      "name": "clients",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "${MVNW} -q -B -Dacp.version=${ACP_VERSION} compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt",
      "run": "java -Xmx1g -Dacp.client.level=INFO -cp target/classes:$(cat target/classpath.txt) load.LoadClients http://127.0.0.1:${PORT}/acp 50 10 perclient",
      "timeoutSec": 300
    }
  ],
  "assertions": {
    "requiredOutput": {
      "clients": [
        "PEAK_REACHED",
        "CLOSED"
      ]
    },
    "forbiddenOutput": {
      "clients": [
        "ERROR ",
        "CLOSE_ERROR"
      ]
    },
    "checks": [
      "clients RESULT errors == 0",
      "clients RESULT ok == expected",
      "clients RESULT expected == 500",
      "clients RESULT updates == 2*ok",
      "clients RESULT close_errors == 0",
      "server SAMPLE peak acp_threads <= 4",
      "server SAMPLE after_close acp_threads <= 4",
      "server SAMPLE peak heap_mb <= 256",
      "server SAMPLE after_close heap_mb <= 64"
    ]
  }
}
