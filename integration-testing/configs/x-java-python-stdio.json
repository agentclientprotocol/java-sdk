{
  "name": "x-java-python-stdio",
  "description": "java client -> python agent over stdio, stable profile, 70 steps (generated)",
  "timeoutSec": 590,
  "peers": [
    "python-sdk"
  ],
  "processes": [
    {
      "name": "client",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/java/launch/build.sh && IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" PY_SDK=\"${peer.python-sdk}\" PYTHONUNBUFFERED=\"1\" ${ROOT}/programs/python/launch/build.sh",
      "run": "${ROOT}/programs/java/launch/client.sh --transport stdio",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.client-capabilities,init.auth-methods,init.agent-info,init.config-boolean,auth.authenticate,auth.logout,auth.logout-capability,auth.terminal,session.new,session.load,session.load-replay,session.resume,session.list,session.close,session.delete,session.multi,update.agent_message_chunk,update.user_message_chunk,update.agent_thought_chunk,update.tool_call,update.tool_call_update,update.tool_call-name,update.plan,update.available_commands_update,update.current_mode_update,update.config_option_update,update.session_info_update,update.usage_update,update.unknown,stop.max_tokens,stop.refusal,stop.max_turn_requests,enum.tool_call,enum.plan,enum.stop,enum.audience,mode.set,config.on-new,config.select,config.boolean,config.grouped,perm.selected,perm.cancelled,fs.write,fs.read,fs.read-range,fs.read-missing,term.run,term.kill,elicit.form,elicit.complete,cancel.prompt,cancel-request.client,cancel-request.agent,cancel-request.unknown,ext.agent-request,ext.agent-notification,ext.client-request,ext.client-notification,meta.prompt,meta.permission,error.method-not-found,big.prompt-1m,big.update-1m,big.prompt-8m,big.update-8m,stdio.eof-exit,conn.close",
        "AGENT_CMD": "${ROOT}/programs/python/launch/agent.sh --transport stdio",
        "PY_SDK": "${peer.python-sdk}",
        "PYTHONUNBUFFERED": "1"
      },
      "timeoutSec": 470
    }
  ],
  "assertions": {
    "requiredOutput": {
      "client": [
        "STEP agent.init.client-capabilities PASS",
        "STEP agent.auth.authenticate PASS",
        "STEP agent.session.close PASS",
        "STEP agent.mode.set PASS",
        "STEP agent.config.grouped PASS",
        "STEP agent.perm.selected PASS",
        "STEP agent.perm.cancelled PASS",
        "STEP agent.fs.write PASS",
        "STEP agent.fs.read PASS",
        "STEP agent.fs.read-range PASS",
        "STEP agent.fs.read-missing PASS",
        "STEP agent.term.run PASS",
        "STEP agent.term.kill PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS",
        "STEP agent.ext.agent-request PASS",
        "STEP agent.meta.permission PASS"
      ]
    },
    "checks": [
      "client RESULT pass == 67",
      "client RESULT fail == 3"
    ],
    "expectedFailures": [
      {
        "process": "client",
        "step": "enum.audience",
        "contains": "audience: user\"",
        "reason": "Annotations.audience is List[Literal[\"assistant\", \"user\"]] with skip_invalid_items: the agent receives the prompt but the unknown Role interop_future_role is silently dropped, so it reads [user] and chunks \"audience: user\"",
        "see": "peer:python-sdk schema.py:2648 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "agent.enum.audience",
        "contains": "['user']",
        "reason": "Annotations.audience skips invalid items: the Python agent's handler sees audience ['user'], interop_future_role dropped before it",
        "see": "peer:python-sdk schema.py:2648 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.client",
        "contains": "",
        "reason": "The Python SDK routes no $/cancel_request (only the constant exists), so the #slow handler never sees it and the prompt runs its full 10 s",
        "see": "peer:python-sdk meta.py:49 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.agent",
        "contains": "cancel-request",
        "reason": "The Python agent cannot send $/cancel_request (no API), so it answers the chunk \"cancel-request unsupported\" instead of \"cancel-request sent\"",
        "see": "peer:python-sdk meta.py:49 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "agent.cancel-request.agent",
        "contains": "$/cancel_request",
        "reason": "The Python agent cannot send $/cancel_request for its pending fs/read_text_file (no API)",
        "see": "peer:python-sdk meta.py:49 [expectations/python.json]"
      }
    ],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from steps.json, matrix.json and expectations/*.json; do not edit, regenerate."
}
