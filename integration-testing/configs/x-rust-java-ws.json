{
  "name": "x-rust-java-ws",
  "description": "rust client -> java agent over ws, stable profile, 72 steps (generated)",
  "timeoutSec": 600,
  "peers": [
    "rust-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/java",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/java/launch/build.sh",
      "run": "${ROOT}/programs/java/launch/agent.sh --transport ws --port ${PORT}",
      "env": {
        "RUST_SDK": "${peer.rust-sdk}",
        "CARGO_TARGET_DIR": "${CACHE}/build/${peerKey.rust-sdk}"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "rust",
      "role": "client",
      "dir": "${ROOT}/programs/rust",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" RUST_SDK=\"${peer.rust-sdk}\" CARGO_TARGET_DIR=\"${CACHE}/build/${peerKey.rust-sdk}\" ${ROOT}/programs/rust/launch/build.sh",
      "run": "${ROOT}/programs/rust/launch/client.sh --transport ws --url ws://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.client-capabilities,init.auth-methods,init.agent-info,init.config-boolean,auth.authenticate,auth.logout,auth.logout-capability,auth.terminal,session.new,session.load,session.load-replay,session.resume,session.list,session.close,session.delete,session.multi,update.agent_message_chunk,update.user_message_chunk,update.agent_thought_chunk,update.tool_call,update.tool_call_update,update.tool_call-name,update.plan,update.available_commands_update,update.current_mode_update,update.config_option_update,update.session_info_update,update.usage_update,update.unknown,stop.max_tokens,stop.refusal,stop.max_turn_requests,enum.tool_call,enum.plan,enum.stop,enum.audience,mode.set,config.on-new,config.select,config.boolean,config.grouped,perm.selected,perm.cancelled,fs.write,fs.read,fs.read-range,fs.read-missing,term.run,term.kill,elicit.form,elicit.complete,cancel.prompt,cancel.prompt-while-cancelling,cancel.grace,cancel.max-duration,cancel-request.client,cancel-request.agent,cancel-request.unknown,ext.agent-request,ext.agent-notification,ext.client-request,ext.client-notification,meta.prompt,meta.permission,error.method-not-found,big.prompt-1m,big.update-1m,big.prompt-8m,big.update-8m,conn.close",
        "RUST_SDK": "${peer.rust-sdk}",
        "CARGO_TARGET_DIR": "${CACHE}/build/${peerKey.rust-sdk}"
      },
      "timeoutSec": 480
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.init.client-capabilities PASS",
        "STEP agent.auth.authenticate PASS",
        "STEP agent.session.close PASS",
        "STEP agent.enum.audience PASS",
        "STEP agent.mode.set PASS",
        "STEP agent.config.grouped PASS",
        "STEP agent.perm.selected PASS",
        "STEP agent.perm.cancelled PASS",
        "STEP agent.fs.write PASS",
        "STEP agent.fs.read PASS",
        "STEP agent.fs.read-range PASS",
        "STEP agent.fs.read-missing PASS",
        "STEP agent.term.run PASS",
        "STEP agent.term.kill PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS",
        "STEP agent.cancel-request.client PASS",
        "STEP agent.cancel-request.agent PASS",
        "STEP agent.ext.agent-request PASS",
        "STEP agent.meta.permission PASS"
      ]
    },
    "requiredPatterns": {
      "agent": [
        "\\[http\\] GET /acp HTTP/1\\.1 -> 101 .*upgrade=\"websocket\""
      ]
