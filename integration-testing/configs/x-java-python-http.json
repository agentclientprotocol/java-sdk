{
  "name": "x-java-python-http",
  "description": "java client -> python agent over http, stable profile, 65 steps (generated)",
  "timeoutSec": 565,
  "peers": [
    "python-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "python",
      "role": "server",
      "dir": "${ROOT}/programs/python",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" PY_SDK=\"${peer.python-sdk}\" PYTHONUNBUFFERED=\"1\" ${ROOT}/programs/python/launch/build.sh",
      "run": "${ROOT}/programs/python/launch/agent.sh --transport http --port ${PORT}",
      "env": {
        "PY_SDK": "${peer.python-sdk}",
        "PYTHONUNBUFFERED": "1"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/java/launch/build.sh",
      "run": "${ROOT}/programs/java/launch/client.sh --transport http --url http://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.client-capabilities,init.auth-methods,init.agent-info,init.config-boolean,auth.authenticate,auth.logout,auth.logout-capability,auth.terminal,session.new,session.load,session.load-replay,session.resume,session.list,session.close,session.delete,session.multi,update.agent_message_chunk,update.user_message_chunk,update.agent_thought_chunk,update.tool_call,update.tool_call_update,update.tool_call-name,update.plan,update.available_commands_update,update.current_mode_update,update.config_option_update,update.session_info_update,update.usage_update,update.unknown,stop.max_tokens,stop.refusal,stop.max_turn_requests,mode.set,config.on-new,config.select,config.boolean,perm.selected,perm.cancelled,fs.write,fs.read,fs.read-range,fs.read-missing,term.run,term.kill,elicit.form,elicit.complete,cancel.prompt,cancel-request.client,cancel-request.agent,cancel-request.unknown,ext.agent-request,ext.agent-notification,ext.client-request,ext.client-notification,meta.prompt,meta.permission,error.method-not-found,big.prompt-1m,big.update-1m,big.prompt-8m,big.update-8m,http.reconnect,conn.close",
        "PY_SDK": "${peer.python-sdk}",
        "PYTHONUNBUFFERED": "1"
      },
      "timeoutSec": 445
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.init.client-capabilities PASS",
        "STEP agent.auth.authenticate PASS",
        "STEP agent.mode.set PASS",
        "STEP agent.perm.selected PASS",
        "STEP agent.perm.cancelled PASS",
        "STEP agent.fs.write PASS",
        "STEP agent.fs.read PASS",
        "STEP agent.fs.read-range PASS",
        "STEP agent.fs.read-missing PASS",
        "STEP agent.term.run PASS",
        "STEP agent.term.kill PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS",
        "STEP agent.ext.agent-request PASS",
        "STEP agent.meta.permission PASS"
      ]
    },
    "checks": [
      "client RESULT pass == 56",
      "client RESULT fail == 9"
    ],
    "expectedFailures": [
      {
        "process": "client",
        "step": "session.resume",
        "contains": "-32601",
        "reason": "The SDK's HTTP server builds each AgentSideConnection without use_unstable_protocol, so session/resume (unstable in the Python SDK) is answered method-not-found although the agent implements it",
        "see": "peer:python-sdk http/server.py:270 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "session.close",
        "contains": "-32601",
        "reason": "The SDK's HTTP server never enables the unstable router: session/close is answered method-not-found",
        "see": "peer:python-sdk http/server.py:270 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "session.delete",
        "contains": "404",
        "reason": "The Java client opens a session-scoped stream for the unknown id \"no-such-session\" before deleting it; the Python server answers an unknown Acp-Session-Id 404 as the RFD says (http/server.py:300), so delete-unknown-succeeds-silently cannot be observed (as for the Java agent in java.json)",
        "see": "spec:rfds/streamable-http-websocket-transport.mdx:268 [expectations/python.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.client",
        "contains": "P2:",
        "reason": "The Java client has no $/cancel_request send",
        "see": "P2 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.agent",
        "contains": "P2:",
        "reason": "The Java client does not honour $/cancel_request from the agent; its fs read is never cancelled",
        "see": "P2 [expectations/java.json]"
      },
      {
        "process": "agent",
        "step": "agent.cancel-request.agent",
        "contains": "",
        "reason": "The Java client does not honour the agent's $/cancel_request, so the fs read never ends with -32800",
        "see": "P2 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "cancel-request.unknown",
        "contains": "P2:",
        "reason": "The Java client has no $/cancel_request send",
        "see": "P2 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "ext.client-request",
        "contains": "P9:",
        "reason": "AcpAsyncClient has no generic request send",
        "see": "P9 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "ext.client-notification",
        "contains": "P9:",
        "reason": "AcpAsyncClient has no generic notification send",
        "see": "P9 [expectations/java.json]"
      },
      {
        "process": "client",
        "step": "http.reconnect",
        "contains": "404",
        "reason": "RFD gap B: the Java client opens the session stream (GET with Acp-Session-Id) before session/load on the new connection; the Python server knows a session stream only once a load or new created it (:196-199), so the GET is a 404 (the legacy interop-python-server XFAIL)",
        "see": "peer:python-sdk http/server.py:300 [expectations/python.json]"
      }
    ],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from steps.json, matrix.json and expectations/*.json; do not edit, regenerate."
}
