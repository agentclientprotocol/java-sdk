{
  "name": "fw-micronaut-client-http",
  "description": "micronaut-built java client -> typescript agent over http, 10 smoke steps (generated from smoke.json)",
  "timeoutSec": 350,
  "peers": [
    "typescript-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "typescript",
      "role": "server",
      "dir": "${ROOT}/programs/node",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" TS_SDK=\"${peer.typescript-sdk}\" ${ROOT}/programs/node/launch/build.sh",
      "run": "${ROOT}/programs/node/launch/agent.sh --transport http --port ${PORT}",
      "env": {
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/micronaut",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/micronaut/launch/build.sh",
      "run": "${ROOT}/programs/micronaut/launch/client.sh --transport http --url http://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-info,session.new,update.agent_message_chunk,perm.selected,fs.read,elicit.form,cancel.prompt,ext.client-request,conn.close",
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "timeoutSec": 170
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.perm.selected PASS",
        "STEP agent.fs.read PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS"
      ]
    },
    "checks": [
      "client RESULT pass == 10",
      "client RESULT fail == 0"
    ],
    "expectedFailures": [],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from smoke.json, steps.json and matrix.json; do not edit, regenerate."
}
