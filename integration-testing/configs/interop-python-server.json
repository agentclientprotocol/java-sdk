{
  "name": "interop-python-server",
  "description": "Java client -> Python SDK server (Hypercorn, h2c enabled)",
  "timeoutSec": 240,
  "peers": [
    "python-sdk"
  ],
  "processes": [
    {
      "name": "server",
      "language": "python",
      "role": "server",
      "dir": "${ROOT}/programs/python",
      "run": "${peer.python-sdk}/.venv/bin/python py-server.py",
      "env": {
        "PORT": "${PORT}",
        "PYTHONUNBUFFERED": "1"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "${MVNW} -q -B -Dacp.version=${ACP_VERSION} compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt",
      "run": "java -cp target/classes:$(cat target/classpath.txt) interop.JavaClientMain http://127.0.0.1:${PORT}/acp",
      "timeoutSec": 120
    }
  ],
  "assertions": {
    "requiredOutput": {
      "client": [
        "negotiated HTTP_2",
        "permission request:",
        "STEP initialize PASS",
        "STEP session/new PASS",
        "STEP prompt1 PASS",
        "STEP prompt2 PASS",
        "STEP prompt3-permission PASS",
        "STEP session/load PASS",
        "STEP prompt-after-load PASS",
        "STEP close PASS",
        "STEP reconnect-initialize PASS",
        "STEP reconnect-close PASS"
      ],
      "server": [
        "[agent] permission result",
        "[agent] session/load"
      ]
    },
    "forbiddenOutput": {
      "client": [
        "negotiated HTTP_1_1"
      ]
    },
    "requiredPatterns": {
      "server": [
        "\\[http\\] POST /acp HTTP/2 .*-> 200",
        "\\[http\\] DELETE /acp HTTP/2 .*-> 202"
      ]
    },
    "checks": [
      "client RESULT pass == 12",
      "client RESULT fail == 0",
      "client RESULT prompt1_updates >= 2",
      "client RESULT prompt2_updates >= 2",
      "client RESULT prompt3_permission_updates >= 2",
      "client RESULT prompt_after_load_updates >= 2"
    ]
  },
  "comment": "Reconnect-then-load passes against the Python server since fe7567a: when a server answers the session-stream GET with 404 (as Python does for a session unknown to the connection), the Java client posts session/load on the connection without Acp-Session-Id. The RFD still contradicts itself here (reconnect diagram vs the unknown-session 404 rule)."
}
