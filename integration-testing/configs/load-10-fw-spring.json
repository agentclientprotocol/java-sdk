{
  "name": "load-10-fw-spring",
  "description": "10 connections x 10 prompts against the spring-hosted agent over http, two streamed updates each (generated from smoke.json)",
  "timeoutSec": 420,
  "processes": [
    {
      "name": "server",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/spring",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/spring/launch/build.sh",
      "run": "${ROOT}/programs/spring/launch/agent.sh --transport http --port ${PORT}",
      "env": {
        "JAVA_OPTS": "-Xmx512m"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 90
      }
    },
    {
      "name": "clients",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/java/launch/build.sh",
      "run": "java -Xmx1g -Dacp.client.level=INFO -cp target/classes:$(cat target/classpath.txt) load.LoadClients http://127.0.0.1:${PORT}/acp 10 10 perclient",
      "timeoutSec": 300
    }
  ],
  "assertions": {
    "requiredOutput": {
      "clients": [
        "PEAK_REACHED",
        "CLOSED"
      ]
    },
    "forbiddenOutput": {
      "clients": [
        "ERROR ",
        "CLOSE_ERROR"
      ],
      "server": [
        " ERROR "
      ]
    },
    "checks": [
      "clients RESULT errors == 0",
      "clients RESULT ok == expected",
      "clients RESULT expected == 100",
      "clients RESULT updates == 2*ok",
      "clients RESULT close_errors == 0"
    ]
  },
  "comment": "GENERATED by GenConfigs.java from smoke.json, steps.json and matrix.json; do not edit, regenerate."
}
