{
  "name": "interop-ts-server",
  "description": "Java client -> TypeScript SDK server (example wiring as shipped: HTTP handler plus WebSocket upgrade listener)",
  "timeoutSec": 240,
  "peers": [
    "typescript-sdk"
  ],
  "processes": [
    {
      "name": "server",
      "language": "node",
      "role": "server",
      "dir": "${ROOT}/programs/node",
      "run": "node ts-server.mjs",
      "env": {
        "TS_SDK": "${peer.typescript-sdk}",
        "PORT": "${PORT}"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 60
      }
    },
    {
      "name": "client",
      "language": "java",
      "role": "client",
      "dir": "${ROOT}/programs/java",
      "build": "${MVNW} -q -B -Dacp.version=${ACP_VERSION} compile dependency:build-classpath -Dmdep.outputFile=target/classpath.txt",
      "run": "java -cp target/classes:$(cat target/classpath.txt) interop.JavaClientMain http://127.0.0.1:${PORT}/acp",
      "timeoutSec": 120
    }
  ],
  "assertions": {
    "requiredOutput": {
      "client": [
        "negotiated HTTP_1_1",
        "permission request:",
        "STEP initialize PASS",
        "STEP session/new PASS",
        "STEP prompt1 PASS",
        "STEP prompt2 PASS",
        "STEP prompt3-permission PASS",
        "STEP session/load PASS",
        "STEP prompt-after-load PASS",
        "STEP close PASS",
        "STEP reconnect-initialize PASS",
        "STEP reconnect-session/load PASS",
        "STEP reconnect-prompt PASS",
        "STEP reconnect-close PASS"
      ],
      "server": [
        "[agent] permission result",
        "[agent] session/load"
      ]
    },
    "forbiddenOutput": {
      "client": [
        "negotiated HTTP_2"
      ]
    },
    "requiredPatterns": {
      "server": [
        "\\[http\\] POST /acp HTTP/1\\.1 .*-> 200",
        "\\[http\\] DELETE /acp HTTP/1\\.1 .*-> 202"
      ]
    },
    "checks": [
      "client RESULT pass == 12",
      "client RESULT fail == 0",
      "client RESULT prompt1_updates >= 2",
      "client RESULT prompt2_updates >= 2",
      "client RESULT prompt3_permission_updates >= 2",
      "client RESULT prompt_after_load_updates >= 2",
      "client RESULT reconnect_prompt_updates >= 2"
    ]
  },
  "comment": "Node has no h2c, and its upgrade listener would take the JDK's 'Upgrade: h2c' as a WebSocket request (405); the Java client pins HTTP/1.1 after its GET probe."
}
