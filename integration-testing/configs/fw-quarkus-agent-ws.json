{
  "name": "fw-quarkus-agent-ws",
  "description": "typescript client -> quarkus-hosted java agent over ws, 13 smoke steps (generated from smoke.json)",
  "timeoutSec": 365,
  "peers": [
    "typescript-sdk"
  ],
  "processes": [
    {
      "name": "agent",
      "language": "java",
      "role": "server",
      "dir": "${ROOT}/programs/quarkus",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" ${ROOT}/programs/quarkus/launch/build.sh",
      "run": "${ROOT}/programs/quarkus/launch/agent.sh --transport ws --port ${PORT}",
      "env": {
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "ready": {
        "line": "READY",
        "timeoutSec": 90
      }
    },
    {
      "name": "client",
      "language": "typescript",
      "role": "client",
      "dir": "${ROOT}/programs/node",
      "build": "IT_ROOT=\"${ROOT}\" MVNW=\"${MVNW}\" ACP_VERSION=\"${ACP_VERSION}\" CACHE=\"${CACHE}\" TS_SDK=\"${peer.typescript-sdk}\" ${ROOT}/programs/node/launch/build.sh",
      "run": "${ROOT}/programs/node/launch/client.sh --transport ws --url ws://127.0.0.1:${PORT}/acp",
      "env": {
        "STEPS": "init.initialize,init.agent-capabilities,init.agent-info,session.new,session.load,session.multi,update.agent_message_chunk,perm.selected,elicit.form,cancel.prompt,ext.client-request,error.method-not-found,conn.close",
        "TS_SDK": "${peer.typescript-sdk}"
      },
      "timeoutSec": 185
    }
  ],
  "assertions": {
    "requiredOutput": {
      "agent": [
        "STEP agent.perm.selected PASS",
        "STEP agent.elicit.form PASS",
        "STEP agent.cancel.prompt PASS"
      ]
    },
    "forbiddenOutput": {
      "agent": [
        " ERROR ",
        " WARN "
      ]
    },
    "requiredPatterns": {
      "client": [
        "STEP init\\.initialize PASS .*\"name\":\"interop-quarkus-agent\""
      ]
    },
    "checks": [
      "client RESULT pass == 13",
      "client RESULT fail == 0"
    ],
    "expectedFailures": [],
    "report": {
      "client": [
        "TIMEOUT"
      ]
    }
  },
  "comment": "GENERATED by GenConfigs.java from smoke.json, steps.json and matrix.json; do not edit, regenerate."
}
