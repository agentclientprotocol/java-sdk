{
  "typescript-sdk": {
    "url": "https://github.com/agentclientprotocol/typescript-sdk.git",
    "ref": "main",
    "build": "npm ci --no-audit --no-fund && npm run build"
  },
  "rust-sdk": {
    "url": "https://github.com/agentclientprotocol/rust-sdk.git",
    "ref": "main",
    "build": "cargo fetch"
  },
  "python-sdk": {
    "url": "https://github.com/agentclientprotocol/python-sdk.git",
    "ref": "main",
    "build": "rm -rf .venv && python3 -m venv .venv && .venv/bin/pip install --quiet --disable-pip-version-check -e '.[http]' 'hypercorn==0.18.0'"
  }
}
