<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Spring Boot programs of the framework smoke cells (integration-testing/smoke.json): an
  @AcpAgent bean served by acp-spring-boot-starter (interop.spring.agent: stdio, or Streamable HTTP
  on the servlet the starter mounts on server.port), and an ACP client bean
  the starter builds from spring.acp.client.* (interop.spring.client). The agent's handlers and the
  client's steps are the shared sources of programs/framework. Not a module of the SDK reactor:
  launch/build.sh builds it against the SDK installed from this checkout (-Dacp.version) and the
  starter's Spring Boot version (-Dspring-boot.version).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.agentclientprotocol.integration</groupId>
    <artifactId>acp-integration-spring</artifactId>
    <version>1</version>

    <properties>
        <!-- Both set by launch/build.sh; never literals here, so the release workflow's SNAPSHOT check stays clean. -->
        <acp.version>set-by-build.sh</acp.version>
        <spring-boot.version>set-by-build.sh</spring-boot.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-spring-boot-starter</artifactId>
            <version>${acp.version}</version>
        </dependency>
        <!-- spring.acp.agent.transport.type=http in a servlet web application: the SDK's servlet,
             mounted on the application's own server (server.port) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-streamable-http-jetty</artifactId>
            <version>${acp.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
            </plugin>
            <!-- The shared smoke agent handlers and client steps -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>framework-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../framework/src/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
