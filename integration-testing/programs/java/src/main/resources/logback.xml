<configuration>
  <!-- stderr, never stdout: on stdio, the agent's stdout is the protocol stream (spec transports.mdx). -->
  <appender name="E" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{0} - %msg%n</pattern></encoder>
  </appender>
  <logger name="com.agentclientprotocol" level="${acp.level:-INFO}"/>
  <!-- DEBUG on the client transport prints the negotiated HTTP version, which scenarios assert on. -->
  <logger name="com.agentclientprotocol.sdk.client.transport" level="${acp.client.level:-DEBUG}"/>
  <logger name="org.eclipse.jetty" level="WARN"/>
  <root level="INFO"><appender-ref ref="E"/></root>
</configuration>
