<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentclientprotocol</groupId>
        <artifactId>acp-java-sdk</artifactId>
        <version>0.19.0-SNAPSHOT</version>
    </parent>

    <artifactId>acp-test</artifactId>
    <packaging>jar</packaging>

    <name>ACP Test Utilities</name>
    <description>Test utilities for ACP SDK - InMemoryTransportPair, MockAcpAgent, MockAcpClient</description>

    <properties>
        <!-- Coverage floors: measured line 78.60%, branch 40.00% (4 of 10), less 2 points (parent pom, JaCoCo) -->
        <jacoco.minimum.line>0.76</jacoco.minimum.line>
        <jacoco.minimum.branch>0.38</jacoco.minimum.branch>
    </properties>

    <dependencies>
        <!-- JSpecify null-marking annotations (@NullMarked packages, @Nullable) -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- ACP Core (required for transport interfaces and schema types) -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-core</artifactId>
        </dependency>
        <!-- The JSON implementation: Jackson 2 by default. Add acp-json-jackson3 to use Jackson 3. -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-json-jackson2</artifactId>
        </dependency>

        <!-- The transport TCK (com.agentclientprotocol.sdk.test.http): the endpoint's options, the
             JUnit suite every host subclasses, and its assertions. -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-http-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- Reactor for async operations -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Test dependencies for module's own tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!-- The transport TCK runs in every host module (acp-http-servlet,
                 acp-streamable-http-jetty, the framework integrations), not here: its coverage
                 is theirs, so this module's gate leaves it out. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>coverage-gate</id>
                        <configuration>
                            <excludes>
                                <exclude>com/agentclientprotocol/sdk/test/http/AcpHttpTransportTck*</exclude>
                                <exclude>com/agentclientprotocol/sdk/test/http/Networks*</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
