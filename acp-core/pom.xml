<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentclientprotocol</groupId>
        <artifactId>acp-java-sdk</artifactId>
        <version>0.19.0-SNAPSHOT</version>
    </parent>

    <artifactId>acp-core</artifactId>
    <packaging>jar</packaging>

    <name>ACP Core</name>
    <description>Core ACP implementation with stdio transport; needs one JSON module (acp-json-jackson2 or acp-json-jackson3) at runtime</description>

    <dependencies>
        <!-- JSpecify null-marking annotations (@NullMarked packages, @Nullable) -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- ACP annotations (@UnstableAcpApi, etc.) - zero-dependency module -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-annotations</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Reactor for async operations -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Jackson annotations on the schema records. Only the annotations: the JSON
             implementation comes from acp-json-jackson2 or acp-json-jackson3, both of
             which read this annotation package. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- acp-core's own tests need a mapper, but cannot depend on acp-json-jackson2
             (it depends on acp-core). They use the small test-only Jackson 2 mapper in
             src/test (TestJacksonAcpJsonMapperSupplier). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- LICENSE and NOTICE for the test-jar, like every other artifact -->
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <!-- The JSON contract suite: the schema serialization tests that every JSON
                 module runs against its own mapper (surefire dependenciesToScan). They
                 obtain their mapper from AcpJsonMapper.createDefault(), so the test-only
                 supplier and its services file are left out. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>json-contract-test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/agentclientprotocol/sdk/AcpTestFixtures*.class</include>
                                <include>com/agentclientprotocol/sdk/json/AcpJsonMapperContractTest*.class</include>
                                <include>com/agentclientprotocol/sdk/json/JsonTree*.class</include>
                                <include>com/agentclientprotocol/sdk/json/StrictMapperFixtures*.class</include>
                                <include>com/agentclientprotocol/sdk/json/UnknownPropertyPolicyTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/AcpJsonRpcMessageTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/AcpSchemaDiscriminatorTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/AcpSchemaSerializationTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/DefaultOnNullTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/McpServerConfigurationTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/SessionManagementTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/SessionUpdateDeserializationTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/WireFormatTest*.class</include>
                                <include>com/agentclientprotocol/sdk/test/GoldenFileTest*.class</include>
                                <include>golden/**</include>
                                <include>META-INF/LICENSE</include>
                                <include>META-INF/NOTICE</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing pilot (PIT), not part of the default build. Measures how well
             the tests catch injected bugs in the protocol core: the two session classes,
             the request/response plumbing they share, and the json package. AcpSchema
             (records: mutated accessors are noise) and logging calls are left out.
             Run: ./mvnw -Ppit -pl acp-core -am test
             Report: acp-core/target/pit-reports/index.html -->
        <profile>
            <id>pit</id>
            <properties>
                <pitest-maven.version>1.30.0</pitest-maven.version>
                <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
                <!-- -Dpit.mutators=STRONGER for the larger set -->
                <pit.mutators>DEFAULTS</pit.mutators>
                <!-- -Dpit.threads=8 on a larger machine -->
                <pit.threads>4</pit.threads>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>pit</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- The pilot scored 90% (DEFAULTS) and 88% (STRONGER) once the
                                 gaps it found were tested; every remaining survivor is
                                 equivalent or log-only. The run fails below this. -->
                            <mutationThreshold>85</mutationThreshold>
                            <targetClasses>
                                <param>com.agentclientprotocol.sdk.spec.AcpClientSession*</param>
                                <param>com.agentclientprotocol.sdk.spec.AcpAgentSession*</param>
                                <param>com.agentclientprotocol.sdk.spec.OutboundMessages*</param>
                                <param>com.agentclientprotocol.sdk.spec.InboundMessages*</param>
                                <param>com.agentclientprotocol.sdk.spec.ResponseResults*</param>
                                <param>com.agentclientprotocol.sdk.spec.AcpError*</param>
                                <param>com.agentclientprotocol.sdk.json.*</param>
                            </targetClasses>
                            <excludedClasses>
                                <param>com.agentclientprotocol.sdk.spec.AcpSchema*</param>
                            </excludedClasses>
                            <targetTests>
                                <param>com.agentclientprotocol.sdk.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <!-- Integration tests: a real CLI process and a stdio
                                     subprocess shutdown; slow, and run by failsafe. -->
                                <param>com.agentclientprotocol.sdk.*IT</param>
                                <!-- Architecture rules: never kill a mutant, cost a class scan. -->
                                <param>com.agentclientprotocol.sdk.ArchitectureTest</param>
                                <param>com.agentclientprotocol.sdk.SchedulerBestPracticesTest</param>
                            </excludedTestClasses>
                            <avoidCallsTo>
                                <avoidCallsTo>org.slf4j</avoidCallsTo>
                            </avoidCallsTo>
                            <mutators>
                                <mutator>${pit.mutators}</mutator>
                            </mutators>
                            <threads>${pit.threads}</threads>
                            <!-- The session tests wait on Reactor timeouts; give a
                                 mutant room before calling it TIMED_OUT. -->
                            <timeoutConstant>8000</timeoutConstant>
                            <timeoutFactor>2.0</timeoutFactor>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <exportLineCoverage>true</exportLineCoverage>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
