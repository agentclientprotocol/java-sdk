<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentclientprotocol</groupId>
        <artifactId>acp-java-sdk</artifactId>
        <version>0.19.0-SNAPSHOT</version>
    </parent>

    <artifactId>acp-core</artifactId>
    <packaging>jar</packaging>

    <name>ACP Core</name>
    <description>Core ACP implementation with stdio transport; needs one JSON module (acp-json-jackson2 or acp-json-jackson3) at runtime</description>

    <properties>
        <!-- JaCoCo's prepare-agent sets argLine; empty when JaCoCo is skipped. -->
        <argLine/>
    </properties>

    <dependencies>
        <!-- JSpecify null-marking annotations (@NullMarked packages, @Nullable) -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- ACP annotations (@UnstableAcpApi, etc.) - zero-dependency module -->
        <dependency>
            <groupId>com.agentclientprotocol</groupId>
            <artifactId>acp-annotations</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Reactor for async operations -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Jackson annotations on the schema records. Only the annotations: the JSON
             implementation comes from acp-json-jackson2 or acp-json-jackson3, both of
             which read this annotation package. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.lincheck</groupId>
            <artifactId>lincheck</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- acp-core's own tests need a mapper, but cannot depend on acp-json-jackson2
             (it depends on acp-core). They use the small test-only Jackson 2 mapper in
             src/test (TestJacksonAcpJsonMapperSupplier). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- LICENSE and NOTICE for the test-jar, like every other artifact -->
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <!-- Lincheck (the *LincheckTest classes) attaches its instrumentation agent at
                 runtime. JDK 21+ warns about a dynamically loaded agent unless
                 EnableDynamicAgentLoading is set; JDK 17 does not know the flag, hence
                 IgnoreUnrecognizedVMOptions. @{argLine} keeps JaCoCo's agent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+IgnoreUnrecognizedVMOptions -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <!-- The JSON contract suite: the schema serialization tests that every JSON
                 module runs against its own mapper (surefire dependenciesToScan). They
                 obtain their mapper from AcpJsonMapper.createDefault(), so the test-only
                 supplier and its services file are left out. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>json-contract-test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/agentclientprotocol/sdk/AcpTestFixtures*.class</include>
                                <include>com/agentclientprotocol/sdk/json/AcpJsonMapperContractTest*.class</include>
                                <include>com/agentclientprotocol/sdk/json/JsonTree*.class</include>
                                <include>com/agentclientprotocol/sdk/json/StrictMapperFixtures*.class</include>
                                <include>com/agentclientprotocol/sdk/json/UnknownPropertyPolicyTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/AcpJsonRpcMessageTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/AcpSchemaDiscriminatorTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/AcpSchemaSerializationTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/DefaultOnNullTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/McpServerConfigurationTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/SessionManagementTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/SessionUpdateDeserializationTest*.class</include>
                                <include>com/agentclientprotocol/sdk/spec/WireFormatTest*.class</include>
                                <include>com/agentclientprotocol/sdk/test/GoldenFileTest*.class</include>
                                <include>golden/**</include>
                                <include>META-INF/LICENSE</include>
                                <include>META-INF/NOTICE</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>
