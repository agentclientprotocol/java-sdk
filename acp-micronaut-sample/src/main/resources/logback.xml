<configuration>
    <!-- Standard error only: over stdio, standard output carries the ACP protocol and one
         log line on it would corrupt the stream. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
